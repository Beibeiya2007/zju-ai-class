# Only server-side. Never use NEXT_PUBLIC_ or VITE_ prefixes for secrets.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-flash
# Optional, only needed to use automatic audio transcription. Must support a Whisper-compatible /audio/transcriptions endpoint.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_API_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1
# Backward-compatible OpenAI key; also usable for OpenAI audio transcription.
OPENAI_API_KEY=
# Optional password for remote access. Required before any non-loopback AI call.
LECTURE_ACCESS_TOKEN=
